# ==============================================================================
# VARIABLES DE ENTORNO - BODA DIGITAL
# ==============================================================================
# Copia este archivo a .env y actualiza los valores con tus datos reales.
# ==============================================================================

# ==============================================================================
# SUPABASE - Configuración de la base de datos
# ==============================================================================
# Obtén estos valores desde el Dashboard de Supabase:
# Settings > API > Project URL y Project API Keys
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-public
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ==============================================================================
# URL DE LA APLICACIÓN
# ==============================================================================
APP_URL=https://tu-dominio.vercel.app

# ==============================================================================
# EMAIL - Notificaciones con Resend
# ==============================================================================
# Obtén tu API Key desde: https://resend.com
# Configura un dominio verificado para EMAIL_FROM
RESEND_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM=no-reply@tudominio.com
ADMIN_EMAIL=novios@email.com

# ==============================================================================
# FEATURES - Activar/Desactivar funcionalidades
# ==============================================================================
ENABLE_RSVP=true
ENABLE_WISHES=true
ENABLE_PHOTO_UPLOAD=true
ENABLE_GUEST_MANAGEMENT=true

# ==============================================================================
# SEGURIDAD Y LIMITACIONES
# ==============================================================================
SESSION_TIMEOUT=60              # Minutos de inactividad antes de cerrar sesión
RATE_LIMIT=60                   # Peticiones por minuto por IP
MAX_UPLOAD_SIZE=10              # Tamaño máximo de subida en MB
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp

# ==============================================================================
# OTRAS CONFIGURACIONES
# ==============================================================================
# DEBUG=true                    # Activar logging detallado en desarrollo
# ENVIRONMENT=development        # development | production
